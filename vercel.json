{
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/서울-강남구",
      "destination": "/gangnam/",
      "permanent": true
    },
    {
      "source": "/서울-강남구/sink-clog",
      "destination": "/gangnam/sink-clog/",
      "permanent": true
    }
  ]
}
